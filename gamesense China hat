---------------------------------------------------------
-- CHINA HAT LOGIC
---------------------------------------------------------
local function destroyChinaHat()
    if hatConnection then
        hatConnection:Disconnect()
        hatConnection = nil
    end
    local character = LocalPlayer.Character
    if character then
        local head = character:FindFirstChild("Head")
        if head then
            local existingHat = head:FindFirstChild("ChinaHatAdornment")
            if existingHat then
                existingHat:Destroy()
            end
        end
    end
    currentHat = nil
end

local function createChinaHat()
    destroyChinaHat()
    if not isHatEnabled then return end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local head = character:WaitForChild("Head", 5)
    if not head then return end

    local hat = Instance.new("ConeHandleAdornment")
    hat.Name = "ChinaHatAdornment"
    hat.Adornee = head
    hat.Parent = head
    
    hat.Height = 0.8
    hat.Radius = 1.8
    hat.CFrame = CFrame.new(0, 0.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
    hat.Color3 = hatColor
    hat.Transparency = 0.1
    hat.AlwaysOnTop = true
    currentHat = hat

    local timePassed = 0
    hatConnection = RunService.RenderStepped:Connect(function(dt)
        if not hat or not hat.Parent or not character:FindFirstChild("Humanoid") or character.Humanoid.Health <= 0 then
            destroyChinaHat()
            return
        end
        timePassed = timePassed + dt
        hat.Transparency = 0.1 + math.sin(timePassed * 6) * 0.1
    end)
end

---------------------------------------------------------
-- KORBLOX LOGIC
---------------------------------------------------------
local function applyKorblox()
    if not isKorbloxEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if hum.RigType == Enum.HumanoidRigType.R15 then
        local rf = char:FindFirstChild("RightFoot")
        local rl = char:FindFirstChild("RightLowerLeg")
        local ru = char:FindFirstChild("RightUpperLeg")
        if ru and rl and rf then
            rf.Transparency = 1
            rl.Transparency = 1
            ru.MeshId = "http://www.roblox.com/asset/?id=902942096"
            ru.TextureID = "http://roblox.com/asset/?id=902843398"
            ru.Color = Color3.new(1, 1, 1)
            ru.Transparency = 0
        end
    else
        local rightLeg = char:FindFirstChild("Right Leg")
        if rightLeg then
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("CharacterMesh") and v.BodyPart == Enum.BodyPart.RightLeg then
                    v:Destroy()
                end
            end
            local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
            if not mesh then
                mesh = Instance.new("SpecialMesh")
                mesh.Parent = rightLeg
            end
            rightLeg.Color = DARK_GREY_COLOR
            rightLeg.Transparency = 0
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = KORBLOX_MESH_ID
            mesh.TextureId = KORBLOX_TEXTURE_ID
            mesh.Scale = Vector3.new(1, 1, 1)
        end
    end
end

task.spawn(function()
    while true do
        if isKorbloxEnabled and LocalPlayer.Character then
            applyKorblox()
        end
        task.wait(0.5)
    end
end)

