-- Expanded Color Options Function
local function getTracerColor()
    local mode = BulletTracer.ColorMode
    if mode == "Electric Blue" then
        return Color3.fromRGB(0, 170, 255)
    elseif mode == "Hot Pink" then
        return Color3.fromRGB(255, 20, 147)
    elseif mode == "White" then
        return Color3.fromRGB(255, 255, 255)
    elseif mode == "Crimson Red" then
        return Color3.fromRGB(255, 30, 30)
    elseif mode == "Lime Green" then
        return Color3.fromRGB(50, 255, 50)
    elseif mode == "Gold Yellow" then
        return Color3.fromRGB(255, 215, 0)
    elseif mode == "Cyan" then
        return Color3.fromRGB(0, 255, 255)
    elseif mode == "Neon Purple" then
        return Color3.fromRGB(180, 0, 255)
    elseif mode == "Rainbow" then
        local hue = (tick() % 2) / 2
        return Color3.fromHSV(hue, 1, 1)
    elseif mode == "Gradient" then
        local t = (math.sin(tick() * 4) + 1) / 2
        return Color3.fromRGB(0, 255, 200):Lerp(Color3.fromRGB(255, 0, 150), t)
    elseif mode == "Pulse RGB" then
        local t = (math.sin(tick() * 8) + 1) / 2
        return Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(255, 0, 80), t)
    elseif mode == "Fire" then
        local t = (math.sin(tick() * 5) + 1) / 2
        return Color3.fromRGB(255, 50, 0):Lerp(Color3.fromRGB(255, 200, 0), t)
    elseif mode == "Cyber Neon" then
        local t = (math.sin(tick() * 6) + 1) / 2
        return Color3.fromRGB(0, 255, 180):Lerp(Color3.fromRGB(255, 0, 200), t)
    end
    return BulletTracer.Color
end

