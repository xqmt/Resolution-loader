-- FOV Outline
local fovOutline = Drawing.new("Circle")
fovOutline.Thickness = 1
fovOutline.Color = Color3.fromRGB(0, 0, 0)
fovOutline.Filled = false
fovOutline.Transparency = 1
fovOutline.Visible = false

local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Filled = false
fovCircle.Transparency = 1
fovCircle.Visible = false


RunService.RenderStepped:Connect(function()
    if SilentAim.ShowFOV and SilentAim.Enabled then
        local viewportSize = Camera.ViewportSize
        local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        
        -- คำนวณ Radius จาก Half-Angle อิงตาม Vertical Field of View ของ Roblox
        local radFOV = math.rad(SilentAim.FOV)
        local radCameraFOV = math.rad(Camera.FieldOfView)
        local radius = (math.tan(radFOV / 2) / math.tan(radCameraFOV / 2)) * (viewportSize.Y / 2)

        if SilentAim.ShowOutline then
            fovOutline.Position = center
            fovOutline.Radius = radius
            fovOutline.Visible = true
        else
            fovOutline.Visible = false
        end

        fovCircle.Position = center
        fovCircle.Radius = radius
        fovCircle.Visible = true
    else
        fovOutline.Visible = false
        fovCircle.Visible = false
    end
end)

local function getCharacter(player)
    return player and player.Character
end

local function isAlive(character)
    if not character then return false end
    if character:GetAttribute("Dead") then return false end
    local health = character:GetAttribute("Health")
    return health == nil or health > 0
end

local function applyChams(player)
    if player == LocalPlayer then return end

    local function updateChams()
        local character = getCharacter(player)
        if not character then return end

        local highlight = character:FindFirstChild("ChamsHighlight")
        local isEnemy = not Chams.TeamCheck or (player:GetAttribute("Team") ~= LocalPlayer:GetAttribute("Team"))

        if Chams.Enabled and isAlive(character) and isEnemy then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "ChamsHighlight"
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = character
            end

            highlight.FillColor = Chams.FillColor
            highlight.OutlineColor = Chams.OutlineColor
            highlight.FillTransparency = Chams.FillTransparency
            highlight.OutlineTransparency = Chams.OutlineTransparency
            highlight.Enabled = true
        elseif highlight then
            highlight.Enabled = false
        end
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.1)
        updateChams()
    end)

    updateChams()
end

for _, player in ipairs(Players:GetPlayers()) do
    applyChams(player)
end
Players.PlayerAdded:Connect(applyChams)

RunService.Heartbeat:Connect(function()
    if not Chams.Enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            local char = getCharacter(player)
            if char and char:FindFirstChild("ChamsHighlight") then
                char.ChamsHighlight.Enabled = false
            end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getCharacter(player)
            if char then
                local highlight = char:FindFirstChild("ChamsHighlight")
                local isEnemy = not Chams.TeamCheck or (player:GetAttribute("Team") ~= LocalPlayer:GetAttribute("Team"))
                
                if isAlive(char) and isEnemy then
                    if not highlight then
                        applyChams(player)
                    else
                        highlight.Enabled = true
                    end
                elseif highlight then
                    highlight.Enabled = false
                end
            end
        end
    end
end)

local function isObstructed(origin, target, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, LocalPlayer.Character }

    local ray = Workspace:Raycast(origin, target - origin, params)
    return ray ~= nil and ray.Instance ~= nil and not ray.Instance:IsDescendantOf(character)
end

local function getTarget(origin)
    local localTeam = LocalPlayer:GetAttribute("Team")
    local look = Camera.CFrame.LookVector
    local best, bestAngle = nil, math.rad(SilentAim.FOV)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local character = getCharacter(player)
        if not isAlive(character) then continue end
        if SilentAim.TeamCheck and player:GetAttribute("Team") == localTeam then continue end

        local part
        if SilentAim.AimPart == "Closest" then
            local head = character:FindFirstChild("Head")
            local torso = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            
            if head and torso then
                local headAngle = math.acos(math.clamp(look:Dot((head.Position - origin).Unit), -1, 1))
                local torsoAngle = math.acos(math.clamp(look:Dot((torso.Position - origin).Unit), -1, 1))
                part = headAngle < torsoAngle and head or torso
            else
                part = head or torso
            end
        else
            part = character:FindFirstChild(SilentAim.AimPart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        end

        if not part then continue end

        local targetPos = part.Position
        local direction = (targetPos - origin).Unit
        local angle = math.acos(math.clamp(look:Dot(direction), -1, 1))

        if angle < bestAngle then
            if SilentAim.WallCheck and isObstructed(origin, targetPos, character) then continue end
            best, bestAngle = part, angle
        end
    end

    return best
end

local function buildHit(origin, part)
    local targetPos = part.Position
    local direction = (targetPos - origin).Unit

    return {
        Distance = (targetPos - origin).Magnitude,
        Instance = part,
        Position = targetPos,
        Normal = -direction,
        Material = part.Material.Name,
        Exit = false
    }
end

-- Hook Remote Silent Aim
local ok, Remotes = pcall(require, game:GetService("ReplicatedStorage").Database.Security.Remotes)
local shootRemote = ok and Remotes and Remotes.Inventory and Remotes.Inventory.ShootWeapon

if shootRemote and shootRemote.Send then
    local oldSend
    local function hookedSend(packet, ...)
        if SilentAim.Enabled and packet and packet.Bullets then
            for _, bullet in ipairs(packet.Bullets) do
                local origin = bullet.Origin
                if origin then
                    local part = getTarget(origin)
                    if part then
                        bullet.Direction = (part.Position - origin).Unit
                        bullet.Hits = { buildHit(origin, part) }
                    end
                end
            end
        end
        return oldSend(packet, ...)
    end

    if typeof(hookfunction) == "function" then
        oldSend = hookfunction(shootRemote.Send, hookedSend)
    else
        oldSend = shootRemote.Send
        shootRemote.Send = hookedSend
    end
end

