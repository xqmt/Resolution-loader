local function hasVestDetails(character)
    if not character then return false end
    local armor = character:FindFirstChild("CharacterArmor")
    if armor and armor:FindFirstChild("VestDetails") then
        return true
    end
    return false
end

local function isEnemyByVest(targetChar)
    if not targetChar then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHasVest     = hasVestDetails(myChar)
    local targetHasVest = hasVestDetails(targetChar)
    if myHasVest then
        return not targetHasVest
    else
        return targetHasVest
    end
end

local function collectCharactersFromFolder()
    local list = {}
    local folder = Workspace:FindFirstChild("Characters")
    if not folder then return list end
    local localChar = LocalPlayer.Character
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("Model") then
            local hasHead = obj:FindFirstChild("Head")
            local hasRoot = obj:FindFirstChild("HumanoidRootPart")
            if (hasHead or hasRoot) and obj ~= localChar then
                table.insert(list, obj)
            end
        end
    end
    return list
end

-- =========================================================
-- ★ RAGEBOT TARGET SELECTION — MEMESENSE STYLE
-- =========================================================
local function findRageTarget()
    local camPos      = Camera.CFrame.Position
    local priorityNm  = RagebotConfig.PriorityEnabled and RagebotConfig.PriorityName or nil
    local hitName     = RagebotConfig.HitPart
    local teamCheck   = RagebotConfig.TeamCheck
    local visibleChk  = RagebotConfig.VisibleCheck
    local wallChk     = RagebotConfig.WallCheck
    local localTeam   = LocalPlayer:GetAttribute("Team")

    local best, bestPlr, bestDist = nil, nil, math.huge
    local priorityPart, priorityPlr = nil, nil

    local allChars = collectCharactersFromFolder()

    for _, char in ipairs(allChars) do
        if char:GetAttribute("Dead") == true then continue end
        if RagebotConfig.IgnoreInvincible and char:GetAttribute("Invincible") == true then continue end
        local hp = char:GetAttribute("Health")
        if hp ~= nil and hp <= 0 then continue end

        local plr = Players:GetPlayerFromCharacter(char)

        if teamCheck then
            if plr and localTeam and plr:GetAttribute("Team") == localTeam then continue end
            if not isEnemyByVest(char) then continue end
        end

        local part = char:FindFirstChild(hitName)
            or char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local dist = (part.Position - camPos).Magnitude
        if dist < 1 then continue end

        if visibleChk then
            local _, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
        end

        if wallChk then
            if not isVisibleRage(part) then
                if not canWallbangRage(part) then continue end
            end
        end

        if priorityNm and plr and plr.Name == priorityNm then
            priorityPart = part
            priorityPlr  = plr
            break
        end

        if dist < bestDist then
            bestDist = dist
            best     = part
            bestPlr  = plr
        end
    end

    if priorityPart then return priorityPart, priorityPlr end
    return best, bestPlr
end

