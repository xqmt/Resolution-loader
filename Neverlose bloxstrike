local MAX_PEN_STEPS = 12

local function GetPenetrationStats(origin, direction, maxPen, ignoreList, targetRoot)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.CollisionGroup = "Bullet"
    local filter = ignoreList or {LocalPlayer.Character, Camera}
    params.FilterDescendantsInstances = filter
    local currentOrigin = origin
    local currentDir = direction
    local accMat = {}
    local totalThickness = 0

    local backParams = RaycastParams.new()
    backParams.FilterType = Enum.RaycastFilterType.Include
    backParams.CollisionGroup = "Bullet"

    for i = 1, MAX_PEN_STEPS do
        local result = Workspace:Raycast(currentOrigin, currentDir * 1000, params)
        if not result then
            if not targetRoot then
                return { Success = true, EndPos = currentOrigin + (currentDir * 1000), TotalThickness = totalThickness }
            end
            return { Success = false, FailReason = "Void (Missed)" }
        end
        if not result.Instance or not result.Instance.Parent then
            return { Success = false, FailReason = "Destroyed Instance" }
        end
        if targetRoot and result.Instance:IsDescendantOf(targetRoot) then
            return { Success = true, EndPos = result.Position, TotalThickness = totalThickness, FailReason = "Hit" }
        end
        table.insert(filter, result.Instance)
        params.FilterDescendantsInstances = filter
        local enterPos = result.Position
        local fakeEnd = enterPos + (currentDir * 1000)
        backParams.FilterDescendantsInstances = {result.Instance}
        local backRes = Workspace:Raycast(fakeEnd, enterPos - fakeEnd, backParams)
        local thickness = 0.5
        if not backRes then
            return { Success = false, FailReason = "Infinite/Block" }
        end
        thickness = (enterPos - backRes.Position).Magnitude
        local mat = backRes.Material
        local limit = MaterialLimits[mat] or 0.25
        accMat[mat] = (accMat[mat] or 0) + thickness
        if accMat[mat] > limit + maxPen then
            return { Success = false, FailReason = string.format("%s (%.1f / %.1f)", mat.Name, accMat[mat], limit + maxPen) }
        end
        currentOrigin = backRes.Position
        totalThickness = totalThickness + thickness

        if totalThickness > (maxPen + 2) then
            return { Success = false, FailReason = "Pen budget exceeded" }
        end
    end
    return { Success = false, FailReason = "Max Steps" }
end

-- =========================================================
-- isVisibleRage
-- =========================================================
local PART_SAMPLE_OFFSETS = {
    Vector3.new( 1,  0,  0),
    Vector3.new(-1,  0,  0),
    Vector3.new( 0,  1,  0),
    Vector3.new( 0, -1,  0),
    Vector3.new( 0,  0,  1),
    Vector3.new( 0,  0, -1),
}

local function raycastVisible(origin, point, filterList)
    local dir = point - origin
    if dir.Magnitude < 0.1 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filterList
    local result = Workspace:Raycast(origin, dir, params)
    return not result
end

local function isVisibleRage(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    local character = targetPart.Parent
    local origin = Camera.CFrame.Position
    local filter = { LocalPlayer.Character, Camera, character }

    if not character:IsA("Model") then
        return raycastVisible(origin, targetPart.Position, filter)
    end

    local cframe = targetPart.CFrame
    local halfSize = targetPart.Size * 0.5
    if raycastVisible(origin, targetPart.Position, filter) then return true end
    for _, offset in ipairs(PART_SAMPLE_OFFSETS) do
        local worldOffset = cframe:VectorToWorldSpace(Vector3.new(
            offset.X * halfSize.X,
            offset.Y * halfSize.Y,
            offset.Z * halfSize.Z
        ))
        if raycastVisible(origin, targetPart.Position + worldOffset, filter) then
            return true
        end
    end

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part ~= targetPart then
            if raycastVisible(origin, part.Position, filter) then
                return true
            end
        end
    end

    return false
end

local function canWallbangRage(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    local origin    = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local hit = Workspace:Raycast(origin, direction, params)
    if not hit then return true end
    if hit.Instance:IsDescendantOf(targetPart.Parent) then return true end
    if not RagebotConfig.AutoWall then return false end
    local stats = GetPenetrationStats(origin, direction.Unit, RagebotConfig.MaxPen, {LocalPlayer.Character, Camera}, targetPart.Parent)
    return stats.Success
end

