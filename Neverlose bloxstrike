local function triggerHitEffect(position)
    if not HitEffectConfig.Enabled then return end
    local selectedParticles = hit_particles[HitEffectConfig.Style]
    if not selectedParticles then return end
    hit_particle_part.Position = position
    for _, item in ipairs(selectedParticles) do
        local emitter = item[1]
        local amount  = item[2]
        if emitter then
            emitter.Color = ColorSequence.new(HitEffectConfig.Color)
            emitter:Emit(amount)
        end
    end
end

