-- ★ AUTO PRIORITY ON DAMAGE TAKEN
-- =========================================================
local lastLocalHealthValue = nil

local function findLikelyAttacker()
    local localChar = LocalPlayer.Character
    if not localChar then return nil end
    local hrp = localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Head")
    if not hrp then return nil end
    local myPos    = hrp.Position
    local localTeam= LocalPlayer:GetAttribute("Team")
    local closest, minDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and not char:GetAttribute("Dead") then
                local hp = char:GetAttribute("Health")
                if hp == nil or hp > 0 then
                    if not RagebotConfig.TeamCheck
                       or player:GetAttribute("Team") ~= localTeam then
                        local thrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                        if thrp then
                            local d = (thrp.Position - myPos).Magnitude
                            if d < minDist then
                                minDist = d
                                closest = player
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function applyAutoPriority(player)
    if not player then return end
    RagebotConfig.PriorityEnabled = true
    RagebotConfig.PriorityName    = player.Name
    pcall(function()
        if Options.rage_priority_enabled then
            Options.rage_priority_enabled:SetValue(true)
        end
        if Options.rage_priority then
            Options.rage_priority:SetValue(player.Name)
        end
    end)
    Library:Notify("Priority Target → " .. player.Name, 2.5)
end

local function setupLocalDamageListener(character)
    if not character then return end
    lastLocalHealthValue = character:GetAttribute("Health") or 100
    character:GetAttributeChangedSignal("Health"):Connect(function()
        local newHealth = character:GetAttribute("Health") or 0
        if lastLocalHealthValue and newHealth < lastLocalHealthValue then
            if RagebotConfig.AutoPriorityOnDamage then
                local attacker = findLikelyAttacker()
                if attacker then applyAutoPriority(attacker) end
            end
        end
        lastLocalHealthValue = newHealth
    end)
end

if LocalPlayer.Character then
    setupLocalDamageListener(LocalPlayer.Character)
end
