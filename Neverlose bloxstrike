function WeaponModsModule.InitHooks()
    if typeof(hookfunction) ~= "function" then return end
    pcall(function()
        for _, obj in next, getgc(true) do
            if type(obj) == "table" then
                if rawget(obj, "FireRate") then
                    pcall(function()
                        table.insert(WeaponModsModule.OriginalData, table.clone(obj))
                        table.insert(WeaponModsModule.FireRateObjects, obj)
                    end)
                end
                if rawget(obj, "setWeaponRecoil") then
                    local oldSetRecoil
                    oldSetRecoil = hookfunction(obj.setWeaponRecoil, function(...)
                        if GunModsConfig.NoRecoil then return end
                        return oldSetRecoil(...)
                    end)
                end
                if rawget(obj, "weaponKick") then
                    local oldKick
                    oldKick = hookfunction(obj.weaponKick, function(p1, p2)
                        if GunModsConfig.NoRecoil then return end
                        return oldKick(p1, p2)
                    end)
                end
                if rawget(obj, "getTrueSpread") then
                    local oldSpread
                    oldSpread = hookfunction(obj.getTrueSpread, function(p1)
                        if GunModsConfig.NoSpread then return 0 end
                        return oldSpread(p1)
                    end)
                end
                if rawget(obj, "shoot") then
                    activeEquippedWeapon = obj
                    if typeof(obj.shoot) == "function" and #debug.getupvalues(obj.shoot) >= 14 then
                        pcall(function()
                            WeaponModsModule.SendFunc = debug.getupvalue(obj.shoot, 14).Inventory.ShootWeapon.Send
                        end)
                    end
                end
            end
            if type(obj) == "function" and debug.getinfo(obj).name == "calculateRecoilOffset" then
                local oldCalc
                oldCalc = hookfunction(obj, function(...)
                    if GunModsConfig.NoRecoil then return UDim2.new() end
                    return oldCalc(...)
                end)
            end
        end
    end)
end

function WeaponModsModule.StartFirerateLoop()
    task.spawn(function()
        while task.wait(0.05) do
            pcall(function()
                local forcedRate = nil
                if RagebotConfig.Enabled then
                    forcedRate = 0.001
                elseif GunModsConfig.FirerateEnabled then
                    forcedRate = math.max(GunModsConfig.FirerateValue, 0.001)
                end
                if forcedRate then
                    for _, obj in next, WeaponModsModule.FireRateObjects do
                        pcall(function()
                            if typeof(setreadonly) == "function" then setreadonly(obj, false) end
                            rawset(obj, "FireRate", forcedRate)
                            if typeof(setreadonly) == "function" then setreadonly(obj, true) end
                        end)
                    end
                else
                    for i, obj in next, WeaponModsModule.FireRateObjects do
                        pcall(function()
                            if typeof(setreadonly) == "function" then setreadonly(obj, false) end
                            rawset(obj, "FireRate", WeaponModsModule.OriginalData[i] and WeaponModsModule.OriginalData[i].FireRate or 0.1)
                            if typeof(setreadonly) == "function" then setreadonly(obj, true) end
                        end)
                    end
                end
            end)
        end
    end)
