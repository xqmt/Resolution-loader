        local slipProps = PhysicalProperties.new(origProps.Density, MovementConfig.LowFriction, origProps.Elasticity, 100, origProps.ElasticityWeight)

        if hum.FloorMaterial == Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then
            local moveDir = hum.MoveDirection.Unit
            local finalSpeed = currSpeed * multiplier
            
            hrp.AssemblyLinearVelocity = Vector3.new(
                moveDir.X * finalSpeed,
                hrp.AssemblyLinearVelocity.Y,
                moveDir.Z * finalSpeed
            )
        end

        if hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude == 0 then
            currSpeed = math.max(MovementConfig.BaseSpeed, currSpeed - MovementConfig.DecelRate * delta)
            hrp.CustomPhysicalProperties = origProps
        end
    else
        if MovementConfig.SpeedEnabled then
            hum.WalkSpeed = MovementConfig.BaseSpeed * MovementConfig.SpeedMultiplier
        end
    end
end)

local function buildHit(origin, part)
    local targetPos = part.Position
    local direction = (targetPos - origin).Unit

    return {
        Distance = (targetPos - origin).Magnitude,
        Instance = part,
        Position = targetPos,
        Normal = -direction,
        Material = part.Material.Name,
        Exit = false
    }
end

-- Hook Remote Engine (Safe Bullet Tracer & Hit Effects)
local ok, Remotes = pcall(require, game:GetService("ReplicatedStorage").Database.Security.Remotes)
local shootRemote = ok and Remotes and Remotes.Inventory and Remotes.Inventory.ShootWeapon

if shootRemote and shootRemote.Send then
    local oldSend
    local function hookedSend(packet, ...)
        if packet and packet.Bullets then
            if ShootSoundConfig.Enabled then
                for _, s in ipairs(Workspace:GetDescendants()) do
                    if s:IsA("Sound") and isGameGunSound(s) then s.Volume = 0 s:Stop() end
                end
                for _, s in ipairs(SoundService:GetDescendants()) do
                    if s:IsA("Sound") and isGameGunSound(s) then s.Volume = 0 s:Stop() end
                end
                playShootSound()
            end

            for _, bullet in ipairs(packet.Bullets) do
                local origin = bullet.Origin
                if origin then
                    local targetToHit = SilentAim.Enabled and getTarget(origin)
                    
                    if targetToHit then
                        bullet.Direction = (targetToHit.Position - origin).Unit
                        bullet.Hits = { buildHit(origin, targetToHit) }
                        playHitSound()
                        triggerHitOverlay()
                        triggerHitEffect(targetToHit.Position)
                        triggerHitChams(targetToHit.Parent)
                        
                        if BulletTracer.Enabled then drawBulletTracer(origin, targetToHit.Position) end
                    else
                        local endPos = origin + (bullet.Direction * 1000)
                        if BulletTracer.Enabled then drawBulletTracer(origin, endPos) end
                    end
                end
            end
        end
        return oldSend(packet, ...)
    end

    if typeof(hookfunction) == "function" then
        oldSend = hookfunction(shootRemote.Send, hookedSend)
    else
        oldSend = shootRemote.Send
        shootRemote.Send = hookedSend
    end
end

