-- =========================================================
-- INSTANT RELOAD
-- =========================================================
local RELOAD_ANIMS = { ["Reload"]=true, ["ReloadStart"]=true, ["ReloadAction"]=true, ["ReloadEnd"]=true }
local RELOAD_SPEED = 199
local reloadHooked = {}

local function isShootAnimName(name)
    if not name or type(name) ~= "string" then return false end
    local lower = name:lower()
    return lower:find("fire") or lower:find("shoot") or lower:find("recoil") or lower:find("muzzle")
end

local function hookAnimationReload(animModule)
    if not animModule or reloadHooked[animModule] then return end
    reloadHooked[animModule] = true
    pcall(function()
        local origPlay = animModule.play
        animModule.play = function(self_anim, animName, ...)
            if RagebotConfig.Enabled and isShootAnimName(animName) then return nil end
            local track = origPlay(self_anim, animName, ...)
            if track and RELOAD_ANIMS[animName] then
                task.defer(function()
                    pcall(function()
                        if GunModsConfig.InstantReload and track.IsPlaying then
                            track:AdjustSpeed(RELOAD_SPEED)
                        end
                    end)
                end)
            end
            return track
        end
    end)
end

local lastReloadWeapon = nil
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            local weapon = getWeaponObjectSafe()
            if not weapon then return end
            if weapon ~= lastReloadWeapon then
                lastReloadWeapon = weapon
                if weapon.Viewmodel and weapon.Viewmodel.Animation then hookAnimationReload(weapon.Viewmodel.Animation) end
                if weapon.CharacterAnimator then hookAnimationReload(weapon.CharacterAnimator) end
            end
            if not GunModsConfig.InstantReload then return end
            if weapon.IsReloading then
                pcall(function()
                    if weapon.Viewmodel and weapon.Viewmodel.Animation and weapon.Viewmodel.Animation.Animations then
                        for name, track in pairs(weapon.Viewmodel.Animation.Animations) do
                            if RELOAD_ANIMS[name] and track.IsPlaying then track:AdjustSpeed(RELOAD_SPEED) end
                        end
                    end
                    if weapon.CharacterAnimator and weapon.CharacterAnimator.Animations then
                        for name, track in pairs(weapon.CharacterAnimator.Animations) do
                            if RELOAD_ANIMS[name] and track.IsPlaying then track:AdjustSpeed(RELOAD_SPEED) end
                        end
                    end
                end)
            end
        end)
    end
end)

task.spawn(function()
    while task.wait(0.05) do
        if not RagebotConfig.Enabled then continue end
        pcall(function()
            local weapon = getWeaponObjectSafe()
            if not weapon then return end
            local function killShootAnims(container)
                if not container or not container.Animations then return end
                for name, track in pairs(container.Animations) do
                    if isShootAnimName(name) and track.IsPlaying then
                        pcall(function() track:Stop(0) end)
                    end
                end
            end
            if weapon.Viewmodel and weapon.Viewmodel.Animation then killShootAnims(weapon.Viewmodel.Animation) end
            if weapon.CharacterAnimator then killShootAnims(weapon.CharacterAnimator) end
        end)
    end
end)

