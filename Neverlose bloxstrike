local function playCustomSound(soundId, volume)
    if not soundId or soundId == "None" or soundId == "" then return end
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.Name        = "CustomSoundEffect"
        sound.SoundId     = soundId
        sound.Volume      = volume or 2
        sound.PlayOnRemove= false
        sound.Parent      = SoundService
        SoundService:PlayLocalSound(sound)
        sound.Ended:Once(function() pcall(function() sound:Destroy() end) end)
        task.delay(3, function()
            if sound and sound.Parent then pcall(function() sound:Destroy() end) end
        end)
    end)
end

local function playShootSound()
    if not ShootSoundConfig.Enabled then return end
    local soundId = ShootSoundIDs[ShootSoundConfig.Mode]
    if soundId then playCustomSound(soundId, ShootSoundConfig.Volume) end
end

local function playHitSound()
    if not HitSoundConfig.Enabled then return end
    local soundId = SoundIDs[HitSoundConfig.Mode]
    if soundId then playCustomSound(soundId, HitSoundConfig.Volume) end
end

local function isGameGunSound(sound)
    if not sound or not sound:IsA("Sound") then return false end
    if sound.Name == "CustomSoundEffect" then return false end
    local name = sound.Name:lower()
    if name:find("shoot") or name:find("fire") or name:find("shot")
        or name:find("gun") or name:find("weapon") or name:find("bang")
        or sound:IsDescendantOf(Camera) then
        return true
    end
    return false
end

local function muteSound(sound)
    if ShootSoundConfig.Enabled and isGameGunSound(sound) then
        sound.Volume = 0
        sound:Stop()
        sound:GetPropertyChangedSignal("Playing"):Connect(function()
            if sound.Playing and ShootSoundConfig.Enabled then
                sound.Volume = 0
                sound:Stop()
            end
        end)
    end
end

local function setupSoundMuter(parent)
    if not parent then return end
    for _, descendant in ipairs(parent:GetDescendants()) do
        if descendant:IsA("Sound") then muteSound(descendant) end
    end
