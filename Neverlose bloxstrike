-- =========================================================
-- HIT CHAMS
-- =========================================================
local lastChamsTime = 0
local CHAMS_COOLDOWN = 0.05

local function triggerHitChams(targetCharacter)
    if not HitChamsConfig.Enabled or not targetCharacter then return end
    local now = os.clock()
    if now - lastChamsTime < CHAMS_COOLDOWN then return end
    lastChamsTime = now

    local cloneModel = Instance.new("Model")
    cloneModel.Name  = "HitChamsGhost"
    for _, part in ipairs(targetCharacter:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local ghostPart = part:Clone()
            ghostPart:ClearAllChildren()
            ghostPart.CanCollide   = false
            ghostPart.Anchored     = true
            ghostPart.Material     = HitChamsConfig.Material
            ghostPart.Color        = HitChamsConfig.Color
            ghostPart.Transparency = 0
            ghostPart.Parent       = cloneModel
            TweenService:Create(ghostPart,
                TweenInfo.new(HitChamsConfig.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Transparency = 1 }):Play()
        end
    end
    cloneModel.Parent = Workspace
    task.delay(HitChamsConfig.Duration + 0.1, function()
        if cloneModel then pcall(function() cloneModel:Destroy() end) end
    end)
end

