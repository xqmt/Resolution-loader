local function getMuzzlePosition(defaultOrigin)
    local vm = Camera:FindFirstChildOfClass("Model") or Camera:FindFirstChild("ViewModel") or Camera:FindFirstChild("Viewmodel")
    if vm then
        local muzzle = vm:FindFirstChild("Muzzle", true) or vm:FindFirstChild("Flash", true) or vm:FindFirstChild("Barrel", true) or vm:FindFirstChild("MuzzleFlash", true)
        if muzzle then
            if muzzle:IsA("BasePart") or muzzle:IsA("MeshPart") then
                return muzzle.Position
            elseif muzzle:IsA("Attachment") then
                return muzzle.WorldPosition
            end
        end
        for _, v in ipairs(vm:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():find("muzzle") or v.Name:lower():find("flash") or v.Name:lower():find("barrel")) then
                return v.Position
            end
        end
    end
    return defaultOrigin
end

-- Enhanced Bullet Tracer Drawing Engine with Advanced Animations
local function drawBulletTracer(startPos, targetPos)
    if not BulletTracer.Enabled then return end

    local origin = getMuzzlePosition(startPos)
    local distance = (targetPos - origin).Magnitude
    if distance < 1 then return end

    local currentColor = getTracerColor()

    local tracer = Instance.new("Part")
    tracer.Name = "BulletTracer"
    
    if BulletTracer.Type == "Square" then
        tracer.Shape = Enum.PartType.Block
        tracer.Size = Vector3.new(BulletTracer.Thickness, BulletTracer.Thickness, 0)
    else
        tracer.Shape = Enum.PartType.Cylinder
        tracer.Size = Vector3.new(0, BulletTracer.Thickness, BulletTracer.Thickness)
    end

    tracer.Anchored = true
    tracer.CanCollide = false
    tracer.CastShadow = false
    tracer.Material = Enum.Material[BulletTracer.Material] or Enum.Material.Neon
    tracer.Color = currentColor
    tracer.Transparency = BulletTracer.Transparency
    
    if BulletTracer.Type == "Square" then
        tracer.CFrame = CFrame.lookAt(origin, targetPos) * CFrame.new(0, 0, 0)
    else
        tracer.CFrame = CFrame.lookAt(origin, targetPos) * CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(90), 0)
    end
    
    tracer.Parent = Workspace

    local highlight = nil
    if BulletTracer.BloomEffect then
        highlight = Instance.new("Highlight")
        highlight.Adornee = tracer
        highlight.FillColor = currentColor
        highlight.OutlineColor = currentColor
        highlight.FillTransparency = math.clamp(BulletTracer.Transparency + 0.2, 0, 1)
        highlight.OutlineTransparency = math.clamp(BulletTracer.Transparency + 0.5, 0, 1)
        highlight.Parent = tracer
    end

    local targetCFrame
    local targetSize
    if BulletTracer.Type == "Square" then
        targetCFrame = CFrame.lookAt(origin, targetPos) * CFrame.new(0, 0, -distance / 2)
        targetSize = Vector3.new(BulletTracer.Thickness, BulletTracer.Thickness, distance)
    else
        targetCFrame = CFrame.lookAt(origin, targetPos) * CFrame.new(0, 0, -distance / 2) * CFrame.Angles(0, math.rad(90), 0)
        targetSize = Vector3.new(distance, BulletTracer.Thickness, BulletTracer.Thickness)
    end

    -- Easing Style Selection
    local easingStyle = Enum.EasingStyle.Sine
    if BulletTracer.AnimEasing == "Linear" then easingStyle = Enum.EasingStyle.Linear
    elseif BulletTracer.AnimEasing == "Elastic" then easingStyle = Enum.EasingStyle.Elastic
    elseif BulletTracer.AnimEasing == "Bounce" then easingStyle = Enum.EasingStyle.Bounce
    elseif BulletTracer.AnimEasing == "Back" then easingStyle = Enum.EasingStyle.Back end

    local growTween = TweenService:Create(tracer, TweenInfo.new(BulletTracer.TravelTime, easingStyle, Enum.EasingDirection.Out), {
        Size = targetSize,
        CFrame = targetCFrame
    })
    
    growTween:Play()

    task.delay(BulletTracer.LifeTime, function()
        if tracer and tracer.Parent then
            if BulletTracer.FadeMode == "Instant" then
                tracer:Destroy()
            elseif BulletTracer.FadeMode == "Shrink" then
                local shrinkSize = Vector3.new(0, 0, 0)
                if highlight then
                    TweenService:Create(highlight, TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        FillTransparency = 1, OutlineTransparency = 1
                    }):Play()
                end
                local fadeTween = TweenService:Create(tracer, TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Size = shrinkSize,
                    Transparency = 1
                })
                fadeTween:Play()
                fadeTween.Completed:Connect(function() tracer:Destroy() end)
            elseif BulletTracer.FadeMode == "Pulse" then
                local pulseTween = TweenService:Create(tracer, TweenInfo.new(BulletTracer.FadeTime / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true), {
                    Transparency = 0.8
                })
                pulseTween:Play()
                pulseTween.Completed:Connect(function() tracer:Destroy() end)
            elseif BulletTracer.FadeMode == "Expand-Out" then
                local expSize = targetSize * 2.5
                if highlight then
                    TweenService:Create(highlight, TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        FillTransparency = 1, OutlineTransparency = 1
                    }):Play()
                end
                local fadeTween = TweenService:Create(tracer, TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = expSize,
                    Transparency = 1
                })
                fadeTween:Play()
                fadeTween.Completed:Connect(function() tracer:Destroy() end)
            else -- Smooth (Default)
                local fadeSize = BulletTracer.Type == "Square" and Vector3.new(0, 0, distance) or Vector3.new(distance, 0, 0)
                if highlight then
                    TweenService:Create(highlight, TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        FillTransparency = 1, OutlineTransparency = 1
                    }):Play()
                end
                local fadeTween = TweenService:Create(tracer, TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Transparency = 1, Size = fadeSize
                })
                fadeTween:Play()
                fadeTween.Completed:Connect(function() tracer:Destroy() end)
            end
        end
    end)
end

