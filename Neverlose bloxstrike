        HealthBar       = createDrawing("Square", {Thickness=1, Color=Color3.fromRGB(0,255,100), Filled=true, Visible=false}),
        Skeletons       = {},
        SkeletonOutlines= {}
    }
    for i = 1, 19 do
        objects.SkeletonOutlines[i] = createDrawing("Line", {Thickness=3, Color=ESPConfig.OutlineColor, Visible=false})
        objects.Skeletons[i]        = createDrawing("Line", {Thickness=1, Color=ESPConfig.SkeletonColor, Visible=false})
    end
