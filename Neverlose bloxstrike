-- Tracer Color Sequence
local function getTracerColorSequence()
    local mode = BulletTracer.ColorMode
    if mode == "Gradient 2 Colors" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, BulletTracer.GradientColor1),
            ColorSequenceKeypoint.new(1, BulletTracer.GradientColor2)
        }
    elseif mode == "Gradient 3 Colors" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, BulletTracer.GradientColor1),
            ColorSequenceKeypoint.new(0.5, BulletTracer.GradientColor2),
            ColorSequenceKeypoint.new(1, BulletTracer.GradientColor3)
        }
    elseif mode == "Cyber Neon" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 240)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 0, 180)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 0, 255))
        }
    elseif mode == "Sunset Glow" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 0, 100)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 0, 200))
        }
    elseif mode == "Cotton Candy" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 150, 220)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 200, 255))
        }
    elseif mode == "Fire" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 0)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 90, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 0, 0))
        }
    elseif mode == "Rainbow" then
        return ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 150, 0)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 100)),
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 150, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 0, 255))
        }
    end
    
    local singleColor = BulletTracer.Color
    if mode == "Electric Blue" then singleColor = Color3.fromRGB(0, 170, 255)
    elseif mode == "Hot Pink" then singleColor = Color3.fromRGB(255, 20, 147)
    elseif mode == "White" then singleColor = Color3.fromRGB(255, 255, 255)
    elseif mode == "Crimson Red" then singleColor = Color3.fromRGB(255, 30, 30)
    elseif mode == "Lime Green" then singleColor = Color3.fromRGB(50, 255, 50)
    elseif mode == "Neon Purple" then singleColor = Color3.fromRGB(180, 0, 255)
    end
    return ColorSequence.new(singleColor)
end

