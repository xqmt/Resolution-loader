local function isRageTargetValid(char)
    if not char or not char.Parent then return false end
    if char:GetAttribute("Dead") == true then return false end
    if RagebotConfig.IgnoreInvincible and char:GetAttribute("Invincible") == true then return false end
    local hp = char:GetAttribute("Health")
    if hp ~= nil and hp <= 0 then return false end
    return true
end

