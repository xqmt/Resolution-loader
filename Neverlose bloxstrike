end)

local function _bhop_isOnGround()
    if not _bhop.Runtime then return true end
    local ok, state = pcall(function() return _bhop.Runtime:getPredictedState() end)
    if not ok or state == nil then return true end
    return state.OnGround == true
end

local function _bhop_pulse()
    if _bhop.Jumping or not _bhop.Module then return end
    _bhop.Jumping = true
    pcall(_bhop.Module.jump, false)
    task.defer(function()
        pcall(_bhop.Module.jump, true)
        task.delay(0.05, function()
            pcall(_bhop.Module.jump, false)
            task.delay(0.05, function()
                _bhop.Jumping = false
            end)
        end)
    end)
end

local function _bhop_stop()
    _bhop.Running  = false
    _bhop.WasInAir = false
    _bhop.Jumping  = false
    if _bhop.Module then pcall(_bhop.Module.jump, false) end
end

local function _bhop_bindMobileJump()
    if not UserInputService.TouchEnabled then return end
    task.spawn(function()
        while task.wait(0.5) do
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local tg = pg and pg:FindFirstChild("TouchGui")
            local tf = tg and tg:FindFirstChild("TouchControlFrame")
            local jb = tf and tf:FindFirstChild("JumpButton")
            if jb and not jb:GetAttribute("NLBhopBound") then
                jb:SetAttribute("NLBhopBound", true)
                jb.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                        _bhop.MobileHeld = true
                    end
                end)
                jb.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                        _bhop.MobileHeld = false
                    end
                end)
                jb.MouseLeave:Connect(function()
                    _bhop.MobileHeld = false
                end)
            end
        end
    end)
end
_bhop_bindMobileJump()

local function _bhop_isHeld()
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then return true end
    if _bhop.MobileHeld then return true end
    return false
end

RunService.Heartbeat:Connect(function()
    if not BhopConfig.Enabled then
        if _bhop.Running then _bhop_stop() end
        return
    end
    if not _bhop_isHeld() then
        if _bhop.Running then _bhop_stop() end
        return
    end
    if not _bhop.Running then
        _bhop.Running  = true
        _bhop.WasInAir = false
        _bhop_pulse()
        return
    end
    local onGround = _bhop_isOnGround()
    if _bhop.WasInAir and onGround then
        _bhop.WasInAir = false
        _bhop_pulse()
    elseif not onGround then
        _bhop.WasInAir = true
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    _bhop_stop()
end)

