                        triggerHitOverlay()
                        triggerHitEffect(targetToHit.Position)
                        triggerHitChams(targetToHit.Parent)
                        if BulletTracer.Enabled then drawBulletTracer(origin, targetToHit.Position) end
                        notifyHit(targetToHit)
                    else
                        local dir         = bullet.Direction or Camera.CFrame.LookVector
                        local maxDistance = 1000
                        local rayParams   = RaycastParams.new()
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        local ignoreList = {}
                        if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
                        if Camera:FindFirstChildOfClass("Model") then table.insert(ignoreList, Camera:FindFirstChildOfClass("Model")) end
                        rayParams.FilterDescendantsInstances = ignoreList
                        local rayRes = Workspace:Raycast(origin, dir * maxDistance, rayParams)
                        local endPos = rayRes and rayRes.Position or (origin + (dir * maxDistance))
                        if BulletTracer.Enabled then drawBulletTracer(origin, endPos) end
                    end
                end
            end
        end
        return oldSend(packet, ...)
    end

    if typeof(hookfunction) == "function" then
        oldSend = hookfunction(shootRemote.Send, hookedSend)
    else
        oldSend = shootRemote.Send
        shootRemote.Send = hookedSend
    end
end

