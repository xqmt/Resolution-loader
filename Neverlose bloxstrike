    local sound = Instance.new("Sound")
    sound.SoundId = SoundIDs[HitSoundMode]
    sound.Volume = HitSoundVolume
    sound.Parent = SoundService
    
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

