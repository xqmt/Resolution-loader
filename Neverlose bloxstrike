local function suppressOneAtmosphere(obj)
    if not obj or obj == AtmosphereObj then return end
    if not obj:IsA("Atmosphere") then return end
    pcall(function()
        if obj.Density ~= 0 then obj.Density = 0 end
        if obj.Haze    ~= 0 then obj.Haze    = 0 end
        if obj.Glare   ~= 0 then obj.Glare   = 0 end
        if obj.Offset  ~= 0 then obj.Offset  = 0 end
    end)
end

local function suppressAllOtherAtmospheres()
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") and obj ~= AtmosphereObj then
