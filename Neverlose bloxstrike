local lastTargetPart = nil
local targetLostTime = 0

task.spawn(function()
    while true do
        if not RagebotConfig.Enabled then
            currentRageTargetPart = nil
            rageCache.part, rageCache.player = nil, nil
            lastTargetPart = nil
            targetLostTime = 0
            task.wait(0.2)
            continue
        end

        local keepOld = false
        if lastTargetPart and lastTargetPart.Parent and not RagebotConfig.WallCheck then
            local char = lastTargetPart.Parent
            local hp = char:GetAttribute("Health")
            local alive = not char:GetAttribute("Dead")
                and not (RagebotConfig.IgnoreInvincible and char:GetAttribute("Invincible") == true)
                and (hp == nil or hp > 0)
            if alive then
                if (not RagebotConfig.TeamCheck) or isEnemyByVest(char) then
                    local _, onScreen = Camera:WorldToViewportPoint(lastTargetPart.Position)
                    if onScreen then keepOld = true end
                end
            end
        end

        if not keepOld then
            local part, plr = findRageTarget()
            currentRageTargetPart = part
            rageCache.part, rageCache.player = part, plr
            rageCache.time = os.clock()
            lastTargetPart = part

            if not part then
                targetLostTime = targetLostTime + 1
                task.wait(math.min(0.08 + targetLostTime * 0.02, 0.25))
                continue
            else
                targetLostTime = 0
            end
        end

        task.wait(RagebotConfig.TargetRefresh or 0.05)
    end
end)

