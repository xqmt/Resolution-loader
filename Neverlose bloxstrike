-- Bhop & Movement Engine
local function setupCharacterMovement(character)
    if not character then return end
    local hum = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hum or not hrp then return end

    local origProps = hrp.CustomPhysicalProperties or PhysicalProperties.new(0.7, 0.3, 0.5, 1, 1)
    local slipProps = PhysicalProperties.new(origProps.Density, MovementConfig.LowFriction, origProps.Elasticity, 100, origProps.ElasticityWeight)

    local stateConn
    stateConn = hum.StateChanged:Connect(function(_, newState)
        if MovementConfig.BhopEnabled and newState == Enum.HumanoidStateType.Landed then
            if hum.MoveDirection.Magnitude > 0 then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                
                currSpeed = math.min(currSpeed + MovementConfig.JumpBoost, MovementConfig.SpeedCap)
                local multiplier = MovementConfig.SpeedEnabled and MovementConfig.SpeedMultiplier or 1.0
                local finalSpeed = currSpeed * multiplier
                
                local moveDir = hum.MoveDirection.Unit
                hrp.CustomPhysicalProperties = slipProps
                hrp.AssemblyLinearVelocity = Vector3.new(
                    moveDir.X * finalSpeed,
                    hrp.AssemblyLinearVelocity.Y + 2,
                    moveDir.Z * finalSpeed
                )
            end
        end
    end)

    character.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if stateConn then stateConn:Disconnect() end
        end
    end)
end

if LocalPlayer.Character then
