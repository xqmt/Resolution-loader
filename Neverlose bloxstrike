local cachedShootWeapon = nil
local cachedShootTime = 0

local function getCachedShootWeapon()
    local now = os.clock()
    if cachedShootWeapon and (now - cachedShootTime) < 0.15 then
        return cachedShootWeapon
    end
    local w = getWeaponObjectSafe()
    if w and w.IsEquipped ~= false and type(w.shoot) == "function" then
        cachedShootWeapon = w
        cachedShootTime = now
        return w
    end
    cachedShootWeapon = nil
    return nil
end

task.spawn(function()
    local nextShotTime = 0
    local lastWallVisible = false

    while true do
        local dt = RunService.Heartbeat:Wait()

        if not RagebotConfig.Enabled then
            nextShotTime = 0
            lastWallVisible = false
            continue
        end

        local target = currentRageTargetPart
        if not target or not target.Parent then
            nextShotTime = 0
            lastWallVisible = false
            continue
        end

        local targetChar = target.Parent
        if targetChar:GetAttribute("Dead") == true
            or (RagebotConfig.IgnoreInvincible and targetChar:GetAttribute("Invincible") == true)
            or (targetChar:GetAttribute("Health") or 100) <= 0 then
            currentRageTargetPart = nil
            rageCache.part, rageCache.player = nil, nil
            lastTargetPart = nil
            nextShotTime = 0
            lastWallVisible = false
            continue
        end

        local weapon = getCachedShootWeapon()
        if not weapon then continue end
        if weapon.IsReloading then continue end

        local ammo = getWeaponAmmo(weapon)
        if ammo ~= nil and ammo <= 0 then
            if RagebotConfig.AutoReload then tryReloadWeapon(weapon) end
            continue
        end

        if RagebotConfig.WallCheck then
            local visibleNow = isVisibleRage(target)
            if not visibleNow then
                local newPart, newPlr = findRageTarget()
                if newPart then
                    currentRageTargetPart = newPart
                    rageCache.part, rageCache.player = newPart, newPlr
                    rageCache.time = os.clock()
                    lastTargetPart = newPart
                    target = newPart
                    visibleNow = true
                    nextShotTime = 0
                else
                    nextShotTime = 0
                    lastWallVisible = false
                    continue
                end
            end
            if visibleNow and not lastWallVisible then
                nextShotTime = 0
            end
            lastWallVisible = visibleNow
        else
            lastWallVisible = false
        end

        local now = os.clock()
        if now < nextShotTime then continue end

        local minInterval = math.max(RagebotConfig.Delay or 0.01, 0.0001)
        local minAllowed  = 1 / (RagebotConfig.MaxShotsPerSec or 100)
        if minInterval < minAllowed then minInterval = minAllowed end

        if RagebotConfig.FastMode then
            local maxShots = RagebotConfig.MaxShotsPerFrame or 4
            local budget   = math.min(dt, 0.05)
            local canShoot = math.min(maxShots, math.floor(budget / minInterval) + 1)
            if canShoot < 1 then canShoot = 1 end

            for _ = 1, canShoot do
                pcall(weapon.shoot, weapon)
            end
            nextShotTime = now + (canShoot * minInterval)
        else
            pcall(weapon.shoot, weapon)
            nextShotTime = now + minInterval
        end
    end
end)

