-- ★ HIT NOTIFY
-- =========================================================
local hitWatchActive = {}

local function getTargetName(char)
    if not char then return "Unknown" end
    local plr = Players:GetPlayerFromCharacter(char)
    if plr then return plr.Name end
    return char:GetAttribute("Name") or char.Name or "Unknown"
end

local function notifyHit(targetPart)
    if not HitNotifyConfig.Enabled then return end
    if not targetPart or not targetPart.Parent then return end
    local targetChar = targetPart.Parent
    local partName   = (targetPart.Name == "Head") and "Head" or targetPart.Name
    local targetName = getTargetName(targetChar)

    if hitWatchActive[targetChar] then return end
    hitWatchActive[targetChar] = true

    local beforeHealth = targetChar:GetAttribute("Health")
    if beforeHealth == nil then beforeHealth = 100 end

    task.delay(0.15, function()
        hitWatchActive[targetChar] = nil

        local afterHealth = targetChar and targetChar.Parent and targetChar:GetAttribute("Health") or nil
        local damage = 0
        if afterHealth ~= nil then
            damage = math.max(0, math.floor(beforeHealth - afterHealth))
        end

        local msg
        if HitNotifyConfig.ShowDamage and damage > 0 and HitNotifyConfig.ShowPartName then
            msg = string.format("Hit %s in the %s for %d damage", targetName, partName, damage)
        elseif HitNotifyConfig.ShowDamage and damage > 0 then
            msg = string.format("Hit %s for %d damage", targetName, damage)
        elseif HitNotifyConfig.ShowPartName then
            msg = string.format("Hit %s in the %s", targetName, partName)
        else
            msg = string.format("Hit %s", targetName)
        end

        Library:Notify(msg, HitNotifyConfig.Duration or 3)
    end)
end

