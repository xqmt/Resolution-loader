-- =========================================================
-- BULLET TRACER
-- =========================================================
local cachedMuzzle = nil
local cachedMuzzleTime = 0

local function getMuzzlePosition(defaultOrigin)
    if cachedMuzzle and cachedMuzzle.Parent and (os.clock() - cachedMuzzleTime) < 0.5 then
        return cachedMuzzle:IsA("Attachment") and cachedMuzzle.WorldPosition or cachedMuzzle.Position
    end
    local vm = Camera:FindFirstChildOfClass("Model") or Camera:FindFirstChild("ViewModel") or Camera:FindFirstChild("Viewmodel")
    if vm then
        local muzzle = vm:FindFirstChild("Muzzle", true) or vm:FindFirstChild("Flash", true)
            or vm:FindFirstChild("Barrel", true) or vm:FindFirstChild("MuzzleFlash", true)
        if muzzle then
            cachedMuzzle = muzzle
            cachedMuzzleTime = os.clock()
            if muzzle:IsA("BasePart") or muzzle:IsA("MeshPart") then return muzzle.Position
            elseif muzzle:IsA("Attachment") then return muzzle.WorldPosition end
        end
        for _, v in ipairs(vm:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():find("muzzle") or v.Name:lower():find("flash") or v.Name:lower():find("barrel")) then
                cachedMuzzle = v
                cachedMuzzleTime = os.clock()
                return v.Position
            end
        end
    end
    return defaultOrigin
end

local function drawBulletTracer(startPos, targetPos)
    local origin = getMuzzlePosition(startPos)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {}
    if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
    if Camera:FindFirstChildOfClass("Model") then table.insert(filterList, Camera:FindFirstChildOfClass("Model")) end
    raycastParams.FilterDescendantsInstances = filterList

    local direction = targetPos - origin
    local rayResult = Workspace:Raycast(origin, direction, raycastParams)
    local finalTargetPos = rayResult and rayResult.Position or targetPos
    local distance = (finalTargetPos - origin).Magnitude
    if distance < 1 then return end

    local colorSeq  = getTracerColorSequence()
    local leadColor = colorSeq.Keypoints[1].Value

    local att0 = Instance.new("Attachment")
    local att1 = Instance.new("Attachment")
    att0.WorldPosition = origin
    att1.WorldPosition = origin
    att0.Parent = Workspace.Terrain
    att1.Parent = Workspace.Terrain

    local light
    if BulletTracer.GlowLight then
        light = Instance.new("PointLight")
        light.Color     = leadColor
        light.Brightness= BulletTracer.GlowBrightness * 2.5
        light.Range     = 15
        light.Shadows   = false
        light.Parent    = att1
    end

    local beam = Instance.new("Beam")
    beam.Name           = "BulletTracerBeam"
    beam.Attachment0    = att0
    beam.Attachment1    = att1
    beam.Color          = colorSeq
    beam.Width0         = BulletTracer.Thickness
    beam.Width1         = BulletTracer.Thickness
    beam.FaceCamera     = true
    beam.LightEmission  = BulletTracer.BloomEffect and 1 or 0.5
    beam.LightInfluence = 0
    beam.Texture        = "rbxassetid://12781800668"
    beam.TextureMode    = Enum.TextureMode.Stretch
    beam.TextureLength  = 0.2
    beam.TextureSpeed   = 0.5
    beam.Transparency   = NumberSequence.new(BulletTracer.Transparency)
    beam.Parent         = Workspace.Terrain

    local cleaned = false
    local function forceCleanup()
        if cleaned then return end
        cleaned = true
        pcall(function() beam:Destroy() end)
        pcall(function() att0:Destroy() end)
        pcall(function() att1:Destroy() end)
    end

    local easingStyle = Enum.EasingStyle.Sine
    if BulletTracer.AnimEasing == "Linear" then easingStyle = Enum.EasingStyle.Linear
    elseif BulletTracer.AnimEasing == "Elastic" then easingStyle = Enum.EasingStyle.Elastic
    elseif BulletTracer.AnimEasing == "Bounce" then easingStyle = Enum.EasingStyle.Bounce
    elseif BulletTracer.AnimEasing == "Back" then easingStyle = Enum.EasingStyle.Back end

    TweenService:Create(att1,
        TweenInfo.new(BulletTracer.TravelTime, easingStyle, Enum.EasingDirection.Out),
        { WorldPosition = finalTargetPos }):Play()

    task.delay(BulletTracer.LifeTime, function()
        if not beam or not beam.Parent then forceCleanup() return end
        if light then
            TweenService:Create(light, TweenInfo.new(BulletTracer.FadeTime), { Brightness = 0 }):Play()
        end
        if BulletTracer.FadeMode == "Instant" then
            forceCleanup()
        else
            local fadeTween = TweenService:Create(beam,
                TweenInfo.new(BulletTracer.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Width0 = 0, Width1 = 0 })
            fadeTween:Play()
            fadeTween.Completed:Once(forceCleanup)
        end
        task.delay(BulletTracer.FadeTime + 0.1, forceCleanup)
    end)
end

