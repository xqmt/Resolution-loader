local function getCharacter(player)
    return player and player.Character
end

local function isAlive(character)
    if not character then return false end
    if character:GetAttribute("Dead") then return false end
    local health = character:GetAttribute("Health")
    return health == nil or health > 0
end

local function isObstructed(origin, target, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, LocalPlayer.Character }

    local ray = Workspace:Raycast(origin, target - origin, params)
    return ray ~= nil and ray.Instance ~= nil and not ray.Instance:IsDescendantOf(character)
end

local function getTarget(origin)
    local localTeam = LocalPlayer:GetAttribute("Team")
    local look = Camera.CFrame.LookVector
    local best, bestAngle = nil, math.rad(SilentAim.FOV)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local character = getCharacter(player)
        if not isAlive(character) then continue end
        if SilentAim.TeamCheck and player:GetAttribute("Team") == localTeam then continue end

        local part
        if SilentAim.AimPart == "Closest" then
            local head = character:FindFirstChild("Head")
            local torso = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            
            if head and torso then
                local headAngle = math.acos(math.clamp(look:Dot((head.Position - origin).Unit), -1, 1))
                local torsoAngle = math.acos(math.clamp(look:Dot((torso.Position - origin).Unit), -1, 1))
                part = headAngle < torsoAngle and head or torso
            else
                part = head or torso
            end
        else
            part = character:FindFirstChild(SilentAim.AimPart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        end

        if not part then continue end

        local targetPos = part.Position
        local direction = (targetPos - origin).Unit
        local angle = math.acos(math.clamp(look:Dot(direction), -1, 1))

        if angle < bestAngle then
            if SilentAim.WallCheck and isObstructed(origin, targetPos, character) then continue end
            best, bestAngle = part, angle
        end
    end

    return best
end

-- Head Hitbox Extender Engine
local originalHeadSizes = {}
local originalHeadColors = {}

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getCharacter(player)
            local localTeam = LocalPlayer:GetAttribute("Team")
            local isEnemy = not HitboxConfig.TeamCheck or (player:GetAttribute("Team") ~= localTeam)

            if char and isAlive(char) and isEnemy then
                local head = char:FindFirstChild("Head")
                if head then
                    if not originalHeadSizes[head] then
                        originalHeadSizes[head] = head.Size
                        originalHeadColors[head] = head.Color
                    end

                    if HitboxConfig.Enabled then
                        local baseSize = originalHeadSizes[head]
                        head.Size = baseSize * HitboxConfig.Size
                        head.Transparency = HitboxConfig.Transparency
                        head.Color = HitboxConfig.Color
                        head.CanCollide = false
                    else
                        head.Size = originalHeadSizes[head]
                        head.Transparency = 0
                        head.Color = originalHeadColors[head] or Color3.fromRGB(255, 255, 255)
                    end
                end
            end
        end
    end
end)

-- RenderStepped Logic (Third Person Removed)
RunService.RenderStepped:Connect(function()
    updateWorldLighting()

    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    if SilentAim.ShowFOV and SilentAim.Enabled then
        local radFOV = math.rad(SilentAim.FOV)
        local radCameraFOV = math.rad(Camera.FieldOfView)
        local radius = (math.tan(radFOV / 2) / math.tan(radCameraFOV / 2)) * (viewportSize.Y / 2)

        fovCircle.Position = center
        fovCircle.Radius = radius
        fovCircle.Visible = true

        if SilentAim.ShowOutline then
            fovOutlineOuter.Position = center
            fovOutlineOuter.Radius = radius + 1.25
            fovOutlineOuter.Visible = true

            fovOutlineInner.Position = center
            fovOutlineInner.Radius = radius - 1.25
            fovOutlineInner.Visible = true
        else
            fovOutlineOuter.Visible = false
            fovOutlineInner.Visible = false
        end
    else
        fovCircle.Visible = false
        fovOutlineOuter.Visible = false
        fovOutlineInner.Visible = false
    end

    for player, objs in pairs(espObjects) do
        local character = getCharacter(player)
        local isEnemy = not ESPConfig.TeamCheck or (player:GetAttribute("Team") ~= LocalPlayer:GetAttribute("Team"))
        
        if ESPConfig.Enabled and character and isAlive(character) and isEnemy and player ~= LocalPlayer then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local head = character:FindFirstChild("Head")
            
            if hrp and head then
                local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    local cframe, size = character:GetBoundingBox()
                    local topWorld = cframe.Position + Vector3.new(0, size.Y / 2, 0)
                    local bottomWorld = cframe.Position - Vector3.new(0, size.Y / 2, 0)
                    
                    local topPos = Camera:WorldToViewportPoint(topWorld)
                    local bottomPos = Camera:WorldToViewportPoint(bottomWorld)
                    
                    local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                    local boxWidth = boxHeight * (size.X / size.Y) * 1.1
                    if boxWidth < boxHeight * 0.4 then boxWidth = boxHeight * 0.5 end
                    
                    local boxPos = Vector2.new(hrpPos.X - boxWidth / 2, topPos.Y)

                    if ESPConfig.Boxes then
                        if ESPConfig.Outline then
                            objs.BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
                            objs.BoxOutline.Position = boxPos
                            objs.BoxOutline.Visible = true
                        else
                            objs.BoxOutline.Visible = false
                        end

                        objs.Box.Size = Vector2.new(boxWidth, boxHeight)
                        objs.Box.Position = boxPos
                        objs.Box.Color = ESPConfig.BoxColor
                        objs.Box.Visible = true
                    else
                        objs.BoxOutline.Visible = false
                        objs.Box.Visible = false
                    end

                    if ESPConfig.HealthBar then
                        local health = character:GetAttribute("Health") or 100
                        local maxHealth = character:GetAttribute("MaxHealth") or 100
                        local healthPercent = math.clamp(health / maxHealth, 0, 1)
                        local barHeight = boxHeight * healthPercent
                        local barPos = Vector2.new(boxPos.X - 5, boxPos.Y + (boxHeight - barHeight))

                        if ESPConfig.Outline then
                            objs.HealthBarOutline.Size = Vector2.new(3, boxHeight + 2)
                            objs.HealthBarOutline.Position = Vector2.new(boxPos.X - 6, boxPos.Y - 1)
                            objs.HealthBarOutline.Visible = true
                        else
                            objs.HealthBarOutline.Visible = false
                        end

                        objs.HealthBar.Size = Vector2.new(1, barHeight)
                        objs.HealthBar.Position = barPos
                        objs.HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                        objs.HealthBar.Visible = true
                    else
                        objs.HealthBarOutline.Visible = false
                        objs.HealthBar.Visible = false
                    end

                    if ESPConfig.Skeletons then
                        local skeletonPairs = {
                            {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
                            {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
                            {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
                            {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
                            {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
                            {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
                        }

                        for idx, pair in ipairs(skeletonPairs) do
                            local partA = character:FindFirstChild(pair[1])
                            local partB = character:FindFirstChild(pair[2])
                            
                            if partA and partB and objs.Skeletons[idx] then
                                local posA, visA = Camera:WorldToViewportPoint(partA.Position)
                                local posB, visB = Camera:WorldToViewportPoint(partB.Position)

                                if visA and visB then
                                    local vecA = Vector2.new(posA.X, posA.Y)
                                    local vecB = Vector2.new(posB.X, posB.Y)

                                    if ESPConfig.Outline then
                                        objs.SkeletonOutlines[idx].From = vecA
                                        objs.SkeletonOutlines[idx].To = vecB
                                        objs.SkeletonOutlines[idx].Visible = true
                                    else
                                        objs.SkeletonOutlines[idx].Visible = false
                                    end

                                    objs.Skeletons[idx].From = vecA
                                    objs.Skeletons[idx].To = vecB
                                    objs.Skeletons[idx].Color = ESPConfig.SkeletonColor
                                    objs.Skeletons[idx].Visible = true
                                else
                                    objs.SkeletonOutlines[idx].Visible = false
                                    objs.Skeletons[idx].Visible = false
                                end
                            end
                        end
                    else
                        for idx = 1, #objs.Skeletons do
                            objs.SkeletonOutlines[idx].Visible = false
                            objs.Skeletons[idx].Visible = false
                        end
                    end
                else
                    objs.BoxOutline.Visible = false
                    objs.Box.Visible = false
                    objs.HealthBarOutline.Visible = false
                    objs.HealthBar.Visible = false
                    for idx = 1, #objs.Skeletons do
                        objs.SkeletonOutlines[idx].Visible = false
                        objs.Skeletons[idx].Visible = false
                    end
                end
            end
        else
            objs.BoxOutline.Visible = false
            objs.Box.Visible = false
            objs.HealthBarOutline.Visible = false
            objs.HealthBar.Visible = false
            for idx = 1, #objs.Skeletons do
                objs.SkeletonOutlines[idx].Visible = false
                objs.Skeletons[idx].Visible = false
            end
        end
    end

    if SilentAim.Enabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        currentTargetPart = getTarget(LocalPlayer.Character.Head.Position)
    else
        currentTargetPart = nil
    end

    if currentTargetPart and currentTargetPart.Parent then
        local targetChar = currentTargetPart.Parent
        local targetHead = targetChar:FindFirstChild("Head") or currentTargetPart
        local screenPos, onScreen = Camera:WorldToViewportPoint(currentTargetPart.Position)
        local headScreenPos, headOnScreen = Camera:WorldToViewportPoint(targetHead.Position)

        if TargetVisuals.SnapLine and onScreen then
            snapLine.From = center
            snapLine.To = Vector2.new(screenPos.X, screenPos.Y)
            snapLine.Color = TargetVisuals.SnapLineColor
            snapLine.Thickness = TargetVisuals.SnapLineThickness
            snapLine.Visible = true
        else
            snapLine.Visible = false
        end

        if TargetVisuals.HeadDot and headOnScreen then
            headDot.Position = Vector2.new(headScreenPos.X, headScreenPos.Y)
            headDot.Color = TargetVisuals.HeadDotColor
            headDot.Radius = TargetVisuals.HeadDotRadius
            headDot.Visible = true
        else
            headDot.Visible = false
        end

        if TargetVisuals.Highlight then
            targetHighlight.Parent = targetChar
            targetHighlight.FillColor = TargetVisuals.HighlightColor
            targetHighlight.Enabled = true
        else
            targetHighlight.Enabled = false
            targetHighlight.Parent = nil
        end
    else
        snapLine.Visible = false
        headDot.Visible = false
        targetHighlight.Enabled = false
        targetHighlight.Parent = nil
    end
end)

