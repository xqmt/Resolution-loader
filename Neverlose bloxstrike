end

local function removePlayerESP(player)
    if not espObjects[player] then return end
    local objs = espObjects[player]
    objs.BoxOutline:Remove()
    objs.Box:Remove()
    objs.HealthBarOutline:Remove()
    objs.HealthBar:Remove()
    for _, line in ipairs(objs.SkeletonOutlines) do line:Remove() end
    for _, line in ipairs(objs.Skeletons) do line:Remove() end
    espObjects[player] = nil
end

local function getCharacter(player) return player and player.Character end

local function isAlive(character)
    if not character then return false end
    if character:GetAttribute("Dead") then return false end
    local health = character:GetAttribute("Health")
    return health == nil or health > 0
end

local function isObstructed(origin, target, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, LocalPlayer.Character }
    local ray = Workspace:Raycast(origin, target - origin, params)
    return ray ~= nil and ray.Instance ~= nil and not ray.Instance:IsDescendantOf(character)
end

