local function loadSkinChanges()
    if not SkinConfig.Enabled then
        Library:Notify("Skin Changes is disabled", 3)
        return
    end
    Library:Notify("Loading Skin Changes...", 3)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(SkinConfig.URL))()
        end)
        if ok then
            SkinConfig.Loaded = true
            Library:Notify("✔ Skin Changes loaded successfully!", 4)
        else
            Library:Notify("✖ Failed to load Skin Changes: " .. tostring(err), 5)
        end
    end)
end

