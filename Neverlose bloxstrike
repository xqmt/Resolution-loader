-- RAGEBOT AUTO RELOAD HELPERS
-- =========================================================
local reloadCooldownUntil = 0
local RELOAD_METHOD_NAMES = { "reload", "Reload", "startReload", "StartReload", "reloadWeapon", "ReloadWeapon" }

local function tryReloadWeapon(weapon)
    if not weapon then return false end
    if weapon.IsReloading then return false end
    if os.clock() < reloadCooldownUntil then return false end

    for _, name in ipairs(RELOAD_METHOD_NAMES) do
        local fn = weapon[name]
        if type(fn) == "function" then
            local ok = pcall(fn, weapon)
            if ok then
                reloadCooldownUntil = os.clock() + (RagebotConfig.ReloadDelay or 0.15)
                return true
            end
        end
    end

    if weapon.Reload and typeof(weapon.Reload) == "RBXScriptSignal" then
        pcall(function() weapon.Reload:Fire() end)
        reloadCooldownUntil = os.clock() + (RagebotConfig.ReloadDelay or 0.15)
        return true
    end

    return false
end

local function getWeaponAmmo(weapon)
    if not weapon then return nil end
    local ammo = weapon.Rounds
    if ammo == nil then ammo = weapon.Ammo end
    if ammo == nil then ammo = weapon.CurrentAmmo end
    if ammo == nil then ammo = weapon.Magazine end
    return ammo
end

