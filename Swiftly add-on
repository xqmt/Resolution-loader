local activeBeams = {}

local function getBeamConfig(isLocal)
    local color1Key = isLocal and "LocalColor1" or "EnemyColor1"
    local color2Key = isLocal and "LocalColor2" or "EnemyColor2"

    return {
        textureKey = Options.TracerTexture.Value,
        color1     = Options[color1Key].Value,
        color2     = Options[color2Key].Value,
        length     = Options.TracerLength.Value,
        glow       = Options.TracerGlow.Value,
        speed      = Options.TracerSpeed.Value,
        size       = Options.TracerSize.Value,
        lifetime   = Options.TracerLifetime.Value,
    }
end

local function spawnBeam(object, worldPosition, isLocal)
    local cfg       = getBeamConfig(isLocal)
    local textureId = Textures[cfg.textureKey] or Textures["Laser"]

    local beam = Instance.new("Beam")
    beam.FaceCamera     = true
    beam.Texture        = textureId
    beam.TextureSpeed   = cfg.speed
    beam.TextureLength  = cfg.length
    beam.Width0         = cfg.size
    beam.Width1         = cfg.size
    beam.LightEmission  = cfg.glow
    beam.Brightness     = cfg.glow
    beam.Transparency   = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 0),
    })
    beam.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, cfg.color1),
        ColorSequenceKeypoint.new(1, cfg.color2),
    })

    local a0 = Instance.new("Attachment")
    a0.WorldCFrame = object.CFrame
    a0.Parent      = Workspace.Terrain

    local a1 = Instance.new("Attachment")
    a1.WorldCFrame = worldPosition
    a1.Parent      = Workspace.Terrain

    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Parent      = Workspace.Ignored

    pcall(function() object:Destroy() end)

    table.insert(activeBeams, {
        beam  = beam,
        a0    = a0,
        a1    = a1,
        start = tick(),
        life  = cfg.lifetime,
    })
end

task.spawn(function()
    while task.wait() do
        local now = tick()
        for i = #activeBeams, 1, -1 do
            local e = activeBeams[i]
            local elapsed = now - e.start
            if elapsed >= e.life then
                local fadeProg = math.clamp((elapsed - e.life) / 0.2, 0, 1)
                pcall(function()
                    e.beam.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, fadeProg),
                        NumberSequenceKeypoint.new(1, fadeProg),
                    })
                end)
                if fadeProg >= 1 then
                    pcall(function() e.beam:Destroy() end)
                    pcall(function() e.a0:Destroy()   end)
                    pcall(function() e.a1:Destroy()   end)
                    table.remove(activeBeams, i)
                end
            end
        end
    end
end)

local function findBeamChild(parent)
    for _, c in ipairs(parent:GetChildren()) do
        if c:IsA("Beam") then return c end
    end
    return nil
end

task.spawn(function()
    local ignored = Workspace:WaitForChild("Ignored", 60)
    if not ignored then return end
    local siren = ignored:WaitForChild("Siren", 60)
    if not siren then return end
    local radius = siren:WaitForChild("Radius", 60)
    if not radius then return end

    radius.ChildAdded:Connect(function(obj)
        if obj.Name ~= "BULLET_RAYS" then return end
        task.wait()

        local beam = findBeamChild(obj)
        if not beam then return end
        local attachment = beam.Attachment1
        if not attachment then return end
        local worldPos = attachment.WorldCFrame

        local owner   = obj:GetAttribute("OwnerCharacter")
        local isLocal = (owner == LocalName)

        if isLocal then
            if not Toggles.LocalTracer.Value then
                pcall(function() obj:Destroy() end)
                return
            end
        else
            if not Toggles.EnemyTracer.Value then
                pcall(function() obj:Destroy() end)
                return
            end
        end

        spawnBeam(obj, worldPos, isLocal)
    end)
end)

