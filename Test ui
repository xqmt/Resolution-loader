    local topBarCover = Instance.new("Frame")
    topBarCover.Size = UDim2.new(1, 0, 0, 20)
    topBarCover.Position = UDim2.new(0, 0, 1, -20)
    topBarCover.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    topBarCover.BorderSizePixel = 0
