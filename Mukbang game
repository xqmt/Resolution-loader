FunnyTab:Button({
    Title = "Turn object into food (Uses 1st Inventory Item)",
    Callback = function()
        local Mouse = LocalPlayer:GetMouse()
        local Character = LocalPlayer.Character
        local Backpack = LocalPlayer:FindFirstChild("Backpack")
        local u34 = (Character and Character:FindFirstChildWhichIsA("Tool")) or (Backpack and Backpack:FindFirstChildWhichIsA("Tool"))
        
        if not u34 then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Error",
                Text = "Get or buy any food first!",
                Duration = 3
            })
            return
        end

        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Universal Transmutation",
            Text = "Using: " .. u34.Name .. ".\nClick an object on the map!",
            Duration = 4
        })

        local connection
        connection = Mouse.Button1Down:Connect(function()
            local MouseTarget = Mouse.Target
            if MouseTarget and MouseTarget:IsA("BasePart") and MouseTarget.Name ~= "Terrain" then
                connection:Disconnect()
                local Handle = u34:FindFirstChild("Handle")
                local Sound = Handle and Handle:FindFirstChildWhichIsA("Sound") or u34:FindFirstChildWhichIsA("Sound")
                
                if Handle then Handle:Destroy() end
                
                local clone = MouseTarget:Clone()
                clone.Name = "Handle"
                clone.CanCollide = false
                clone.Anchored = false
                clone.CFrame = CFrame.new(0, 0, 0)
                clone.Parent = u34
                if Sound then Sound.Parent = clone end

                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Success!",
                    Text = "Object injected into: " .. u34.Name .. "! Re-equip the item.",
                    Duration = 3
                })
            end
        end)
    end
})

