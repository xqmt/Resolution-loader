-- 4. Utilities Tab
local UtilTab = Window:Tab({ Name = "Utilities", Title = "Farm bite", Icon = "settings" })

UtilTab:Button({
    Title = "Eat your first food from inventory (use fried chicken)",
    Callback = function()
        local Character = LocalPlayer.Character
        local Backpack = LocalPlayer:FindFirstChild("Backpack")
        local tool = (Character and Character:FindFirstChildWhichIsA("Tool")) or (Backpack and Backpack:FindFirstChildWhichIsA("Tool"))
        
        if not tool then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Error",
                Text = "Get or buy any food first!",
                Duration = 3
            })
            return
        end

        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Auto Eating",
            Text = "Using: " .. tool.Name .. " ok",
            Duration = 4
        })

        local Name = tool.Name
        task.spawn(function()
            while task.wait(0) do
                local charTool = LocalPlayer.Character:FindFirstChild(Name)
                if charTool then
                    local args = {{
                        CheesePull = false,
                        FoodType = "DrumStick",
                        Action = "Bite",
                        Tool = charTool,
                        Bite = 1
                    }}
                    ReplicatedStorage:WaitForChild("DrumstickEvent"):FireServer(unpack(args))
                end
            end
        end)
    end
})

