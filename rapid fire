local function patchTool(tool)
    if not tool or not tool:IsA("Tool") or modifiedTools[tool] then return end
    
    if getconnections then
        for _, conn in ipairs(getconnections(tool.Activated)) do
            local fn = conn.Function
            if fn then
                if getconstants and setconstant then
                    for idx, val in ipairs(getconstants(fn)) do
                        if type(val) == "number" and val > 0 and val < 2 then
                            setconstant(fn, idx, 0)
                        end
                    end
                end
                if getupvalues and setupvalue then
                    for idx, val in ipairs(getupvalues(fn)) do
                        if type(val) == "number" and val > 0 and val < 2 then
                            setupvalue(fn, idx, 0)
                        end
                    end
                end
            end
        end
    end
    
    modifiedTools[tool] = true
end

RunService.RenderStepped:Connect(function()
    if not (enabled and holding) then return end
    
    local char = lp.Character
    if char then
        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool then
            patchTool(currentTool)
            currentTool:Activate()
        end
    end
end)

mouse.Button1Down:Connect(function()
    if enabled then 
        holding = true 
    end
end)

mouse.Button1Up:Connect(function()
    holding = false
end)

toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    
    if enabled then
        toggleBtn.Text = "Rapid Fire [ON]"
        toggleBtn.TextColor3 = Color3.fromRGB(160, 215, 60)
    else
        toggleBtn.Text = "Rapid Fire [OFF]"
        toggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
        holding = false
    end
end)
