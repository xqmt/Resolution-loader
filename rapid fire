local is_enabled = false
local is_shooting = false
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local modified_tools = {}

local function apply_rapid_fire(tool)
    if not tool or not tool:IsA("Tool") or modified_tools[tool] then return end
    if getconnections then
        for _, conn in pairs(getconnections(tool.Activated)) do
            local old = conn["Function"]
            if old then
                if getconstants and setconstant then
                    for idx, constant in pairs(getconstants(old)) do
                        if type(constant) == "number" and constant > 0 and constant < 2 then
                            setconstant(old, idx, 0)
                        end
                    end
                end
                if getupvalues and setupvalue then
                    for idx, upvalue in pairs(getupvalues(old)) do
                        if type(upvalue) == "number" and upvalue > 0 and upvalue < 2 then
                            setupvalue(old, idx, 0)
                        end
                    end
                end
            end
        end
    end
    modified_tools[tool] = true
end

RunService.RenderStepped:Connect(function()
    if is_enabled and is_shooting then
        local character = LocalPlayer.Character
        if character then
            local tool = character:FindFirstChildOfClass("Tool")
            if tool then
                apply_rapid_fire(tool)
                tool:Activate()
            end
        end
    end
end)

Mouse.Button1Down:Connect(function()
    if is_enabled then is_shooting = true end
end)

Mouse.Button1Up:Connect(function()
    is_shooting = false
end)

ToggleButton.MouseButton1Click:Connect(function()
    is_enabled = not is_enabled
    if is_enabled then
        ToggleButton.Text = "Rapid Fire [ON]"
        ToggleButton.TextColor3 = Color3.fromRGB(160, 215, 60)
        ToggleButton.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    else
        ToggleButton.Text = "Rapid Fire [OFF]"
        ToggleButton.TextColor3 = Color3.fromRGB(150, 150, 150)
        ToggleButton.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
        is_shooting = false
    end
end)
