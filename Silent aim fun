-- Function Check Status
local function alive(p)
    if not p or not p.Character then return false end
    local h = p.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    
    if knockCheckEnabled then
        local be = p.Character:FindFirstChild("BodyEffects")
        if be then
            local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
            if ko and ko.Value then return false end
        end
    end
    return true
end

local function isVisible(part)
    if not wallCheckEnabled then return true end
    local origin = cam.CFrame.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {lp.Character, cam}
    raycastParams.IgnoreWater = true

    local result = workspace:Raycast(origin, part.Position - origin, raycastParams)
    return not result or (result.Instance and result.Instance:IsDescendantOf(part.Parent))
end

-- Get Center Screen Position
local function getScreenCenter()
    return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
end

-- Get Closest Target INSIDE CENTER FOV
local function getClosest()
    local closest = nil
    local maxDist = fovEnabled and fovRadius or math.huge
    local centerPos = getScreenCenter()
    
    for _, p in ipairs(plrs:GetPlayers()) do
        if p ~= lp and alive(p) then
            local part = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("UpperTorso")
            if part and isVisible(part) then
                local pos, on = cam:WorldToViewportPoint(part.Position)
                if on then
                    local distFromCenter = (Vector2.new(pos.X, pos.Y) - centerPos).Magnitude
                    -- ตรวจสอบว่าอยู่ในระยะ FOV กลางหน้าจอหรือไม่
                    if distFromCenter <= maxDist then
                        maxDist = distFromCenter
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

-- Silent Aim Hook System
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(Self, ...)
    if checkcaller() then return OldNamecall(Self, ...) end
    local Args = { ... }
    local Method = getnamecallmethod()
    
    if SilentAimEnabled and locked and tgt and alive(tgt) then
        local SelfClass = ""
        pcall(function() if Self and typeof(Self) == "Instance" then SelfClass = Self.ClassName end end)
        
        local targetPart = tgt.Character:FindFirstChild("HumanoidRootPart") or tgt.Character:FindFirstChild("UpperTorso")
        if targetPart and (Method == "ScreenPointToRay" or Method == "ViewportPointToRay") and SelfClass == "Camera" then
            return Ray.new(cam.CFrame.Position, (targetPart.Position - cam.CFrame.Position).Unit)
        end
    end
    return OldNamecall(Self, ...)
end))

